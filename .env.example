# Required
OPENAI_API_KEY=sk-replace-me
INTERVALS_API_KEY=replace-me

# Usually keep athlete ID 0 for the athlete belonging to the API key.
INTERVALS_ATHLETE_ID=0
OPENAI_MODEL=gpt-5.6-sol
APP_PASSWORD=replace-with-at-least-12-random-characters
# -1 = keine automatischen Löschungen (Standard)
DATA_RETENTION_DAYS=-1
OPENAI_DAILY_REQUEST_LIMIT=30
OPENAI_DAILY_TOKEN_LIMIT=150000

# Optional Garmin Connect direct read-only sync.
# A persistent tokenstore is preferred after the first login/MFA setup.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMINTOKENS=/data/garmin_tokens
# Optional local development mode (no Garmin login/library required):
# GARMIN_FIXTURE_PATH=garmin-fixture.example.json
