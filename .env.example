# Required
OPENAI_API_KEY=sk-replace-me
# Optional OpenAI-compatible Responses API endpoint.
# For the default OpenAI API this can stay unchanged. For Microsoft Foundry,
# use the resource/project URL ending in /openai/v1.
OPENAI_BASE_URL=https://api.openai.com/v1
INTERVALS_API_KEY=replace-me

# Usually keep athlete ID 0 for the athlete belonging to the API key.
INTERVALS_ATHLETE_ID=0
OPENAI_MODEL=gpt-5.6-sol
APP_PASSWORD=replace-with-at-least-12-random-characters
# Set true when HTTPS is terminated by a trusted reverse proxy.
COOKIE_SECURE=false
GITHUB_REPOSITORY=Lukas-Beike/ai-coach
GITHUB_TOKEN=
GITHUB_RELEASE_CHECK_SECONDS=900
# -1 = keine automatischen Löschungen (Standard)
DATA_RETENTION_DAYS=-1

# Optional read-only shared iCalendar feed from any calendar provider.
# Treat this URL like a password; it is never shown in the browser or logs.
CALENDAR_ICAL_URL=

# Optional Garmin Connect direct read-only sync.
# A persistent tokenstore is preferred after the first login/MFA setup.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMINTOKENS=/data/garmin_tokens
# Optional local development mode (no Garmin login/library required):
# GARMIN_FIXTURE_PATH=garmin-fixture.example.json
