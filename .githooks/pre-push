#!/bin/sh
# The secret scan runs first and reads the pushed refs from stdin; a failure
# stops the push before anything else runs.
root="$(git rev-parse --show-toplevel)"
python "$root/scripts/check_push_secrets.py" || exit $?
# CI's repository-wide quality ratchet (mypy and Ruff) on a clean export of
# HEAD, so uncommitted edits neither hide nor add findings. The export has no
# node_modules, so the clone's are used for the ESLint part when installed.
tree="$(mktemp -d)" || exit 1
trap 'rm -rf "$tree"' EXIT
git -C "$root" archive --format=tar HEAD | tar -xf - -C "$tree" || exit 1
(cd "$tree" && PACECRAFT_NODE_MODULES="$root/node_modules" python tools/quality_baseline.py)
status=$?
if [ "$status" -eq 2 ]; then
  echo "Push blocked: the quality ratchet could not run (see above). Install the missing tool: npm ci for ESLint, requirements-dev.txt for Ruff and mypy." >&2
  exit 1
elif [ "$status" -ne 0 ]; then
  echo "Push blocked: the quality ratchet found new findings in HEAD (see above). Fix them." >&2
  exit 1
fi
