#!/bin/sh
# The secret scan runs first and reads the pushed refs from stdin; a failure
# stops the push before anything else runs.
root="$(git rev-parse --show-toplevel)"
python "$root/scripts/check_push_secrets.py" || exit $?
# CI's repository-wide quality ratchet (mypy, Ruff, complexity) on a clean
# export of HEAD, so uncommitted edits neither hide nor add findings.
tree="$(mktemp -d)" || exit 1
trap 'rm -rf "$tree"' EXIT
git -C "$root" archive --format=tar HEAD | tar -xf - -C "$tree" || exit 1
if ! (cd "$tree" && python tools/quality_baseline.py); then
  echo "Push blocked: the quality ratchet found new findings in HEAD (see above). Fix them, or install requirements-dev.txt if a tool is missing." >&2
  exit 1
fi
