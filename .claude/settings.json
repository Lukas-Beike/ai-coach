{
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "mcp__graphify"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(./data/**)",
      "Read(//**/ai-coach/data/**)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.*.local)",
      "Edit(./data/**)",
      "Edit(//**/ai-coach/data/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& (Join-Path (git rev-parse --show-toplevel) 'scripts/graphify-session-start.ps1')",
            "shell": "powershell",
            "timeout": 240
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$env:CLAUDE_PROJECT_DIR/scripts/hooks/guard_private_paths.py\"",
            "shell": "powershell",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
