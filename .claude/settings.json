{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./data/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./data/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& (Join-Path (git rev-parse --show-toplevel) 'scripts/graphify-session-start.ps1')",
            "shell": "powershell",
            "timeout": 240
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python (Join-Path (git rev-parse --show-toplevel) 'scripts/hooks/guard_private_paths.py')",
            "shell": "powershell",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
